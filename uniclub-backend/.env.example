# MongoDB Connection
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/uniclub?retryWrites=true&w=majority&appName=uniclub

# JWT Secret for Authentication (Generate a secure random string)
JWT_SECRET=your_jwt_secret_here

# Server Configuration
PORT=5050

# --- Registration policy (ClassHub) ---
# Comma-separated allow-list of email domains for sign-up.
# Leave EMPTY to accept any valid email address.
# Example: ALLOWED_EMAIL_DOMAINS=stu.example.edu,example.edu
ALLOWED_EMAIL_DOMAINS=

# Set to false to let anyone register without being on the imported class roster.
# Default (true) means sign-up requires a matching email + 学号 in EnrolledUser.
REQUIRE_ENROLLED_ROSTER=true

# News API Key (Get from https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# Google Gemini API Key (Get from https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: proxy used for Gemini requests (needed when Google is not directly reachable).
# Example: GEMINI_PROXY=http://127.0.0.1:7890
GEMINI_PROXY=

# Optional: override the Gemini model (default gemini-2.5-flash-lite)
GEMINI_MODEL=

# Quantification: private object storage; credentials are SERVER ONLY.
# COS is implemented. OSS requires another adapter and is not silently emulated.
OBJECT_STORAGE_PROVIDER=cos
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# ECS production overrides (kept in /opt/classhub/shared/backend.env):
# NODE_ENV=production
# HOST=127.0.0.1
# TRUST_PROXY=loopback
# BACKEND_URL=https://47.95.157.51
# CORS_ORIGINS=https://47.95.157.51
# QUANTIFICATION_STORAGE_CONFIG_PATH=/opt/classhub/shared/config/quantification-storage.json

# Admin AI assistant (DeepSeek): AES-256-GCM master key, exactly 32 bytes in Base64.
# Initialize without printing the key: npm run ai:init-secret
# ECS EnvironmentFile: node scripts/init-ai-secret.js /opt/classhub/shared/backend.env
# Keep a private backup; changing this key makes the saved API key unreadable.
# DeepSeek API Key is configured through /admin/ai, never returned to the browser.
AI_SECRET_ENCRYPTION_KEY=
