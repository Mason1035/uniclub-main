diff --git a/uniclub-backend/middleware/memberApiReadAccess.js b/uniclub-backend/middleware/memberApiReadAccess.js
new file mode 100644
--- /dev/null
+++ b/uniclub-backend/middleware/memberApiReadAccess.js
@@ -0,0 +1,26 @@
+const authenticateToken = require('./auth');
+
+// Proposed change: signed-in pages should not expose their JSON to guests.
+// Mutations keep their existing route-level authentication/authorization.
+const memberPrefixes = [
+  '/news', '/events', '/resources', '/announcements', '/past-events',
+  '/social', '/comments', '/featured', '/curation', '/engagement', '/users',
+];
+
+function memberApiReadAccess(req, res, next) {
+  if (req.method !== 'GET' && req.method !== 'HEAD') return next();
+  // Existing <img> URLs have no bearer token. This is a transport compatibility
+  // exception, NOT complete private-media access control. Keep this limitation
+  // explicit until authenticated image delivery is implemented separately.
+  if (/^\/past-events\/[^/]+\/(?:poster|gallery\/\d+)\/?$/i.test(req.path) ||
+      /^\/users\/avatar\/[^/]+\/?$/i.test(req.path)) return next();
+  // Express routes are case-insensitive by default; match their semantics.
+  const normalizedPath = req.path.toLowerCase();
+  const memberRead = memberPrefixes.some(prefix =>
+    normalizedPath === prefix || normalizedPath.startsWith(prefix + '/'));
+  return memberRead ? authenticateToken(req, res, next) : next();
+}
+
+module.exports = memberApiReadAccess;
+module.exports.memberPrefixes = memberPrefixes;
+
