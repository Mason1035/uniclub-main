{
  "version": 2,
  "builds": [
    {
      "src": "uniclub-backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "uniclub-backend/index.js",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "private, no-store",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    },
    {
      "src": "/",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/privacy/?",
      "dest": "/privacy.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/about/?",
      "dest": "/about.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/privacy\\.html",
      "status": 308,
      "headers": {
        "Location": "/privacy"
      }
    },
    {
      "src": "/about\\.html",
      "status": 308,
      "headers": {
        "Location": "/about"
      }
    },
    {
      "src": "/(?:app|404)\\.html",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "private, no-store",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "/robots\\.txt",
      "dest": "/robots.txt",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/pet-assets/(.*)",
      "dest": "/pet-assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|json|woff|woff2|ttf|eot|webp|txt))",
      "dest": "/$1"
    },
    {
      "src": "/(?:auth|settings|saved-posts|notifications|debug|news|announcements|events|social|functions(?:/random-call)?|quantification|fees|resources|admin(?:/(?:roster|members|events(?:/[a-fA-F0-9]{24})?|news|resources|gallery|notifications|ai|quantification|fees))?|(?:article|news|event|events|past-events|resource)/[a-fA-F0-9]{24}|comments/(?:news|event|resource|social)/[a-fA-F0-9]{24})/?",
      "dest": "/app.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "private, no-store",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "private, no-store",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron/daily-news",
      "schedule": "*/5 * * * *"
    }
  ]
}
